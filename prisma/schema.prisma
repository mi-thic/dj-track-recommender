generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// DJ ライブラリの 1 曲
model Track {
  id String @id @default(cuid())

  title  String
  artist String

  /// BPM（小数可: 128.5 など）
  bpm Float

  /// Camelot キー表記（1A〜12A / 1B〜12B）
  camelot String

  /// 一般的な調表記（"Am" / "C" など）。任意入力・表示用
  musicalKey String?

  genre String?

  /// エナジーレベル 1〜10（フロアの熱量）
  energy Int @default(5)

  /// 曲尺（秒）
  durationSec Int?

  releaseYear Int?
  label       String?
  notes       String?

  /// ムード・場面のタグ（"ピーク" "ボーカルあり" など）。1 曲に複数付けられる
  tags String[] @default([])

  /// rekordbox の TrackID。再インポート時の突き合わせに使う
  rekordboxId String? @unique

  /// Spotify のトラック ID。ジャケット表示とプレイリスト書き出しに使う
  spotifyId   String? @unique
  spotifyUrl  String?
  albumArtUrl String?
  /// 国際標準レコーディングコード。Spotify 側の同一曲判定に使える
  isrc String?

  setlistItems SetlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, artist])
  @@index([bpm])
  @@index([camelot])
  @@index([energy])
}

/// Spotify の OAuth トークン。個人用アプリなので 1 行だけ持つ
model SpotifyAccount {
  id String @id @default("singleton")

  spotifyUserId String
  displayName   String?

  accessToken  String
  refreshToken String
  scope        String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 保存したセットリスト
model Setlist {
  id    String  @id @default(cuid())
  name  String
  notes String?

  items SetlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// セットリスト内の 1 曲。position の昇順が曲順
model SetlistItem {
  id String @id @default(cuid())

  setlistId String
  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  /// 曲がライブラリから削除されたらセットからも外す
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  position Int

  @@unique([setlistId, position])
  @@index([trackId])
}
