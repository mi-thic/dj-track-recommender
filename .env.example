# ローカル（ホストの Node）から実行する場合は localhost
# Docker Compose 内では compose ファイル側の environment が優先されます（host は db）
DATABASE_URL="postgresql://dj:djpass@localhost:5432/djapp?schema=public"

# 起動時にサンプルデータを投入するか（Docker Compose 用）
SEED_ON_START="true"

# --- Spotify 連携（任意） -------------------------------------------------
# https://developer.spotify.com/dashboard でアプリを作成して取得します。
#
# Redirect URI はダッシュボードに登録した値と完全一致させること。
# Spotify は http://localhost を許可しないため、ループバックは 127.0.0.1 を使います。
#
# NOTE: Audio Features / Audio Analysis は 2024-11-27 に廃止されており、
#       新規アプリから BPM・キー・エナジーは取得できません。
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"
